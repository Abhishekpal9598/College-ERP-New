{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/pages/login/login.html" },
    { "source": "/login", "destination": "/frontend/pages/login/login.html" },
    { "source": "/dashboard", "destination": "/frontend/pages/dashboard/dashboard.html" },
    { "source": "/students", "destination": "/frontend/pages/students/students.html" },
    { "source": "/teachers", "destination": "/frontend/pages/teachers/teachers.html" },
    { "source": "/attendance", "destination": "/frontend/pages/attendance/attendance.html" },
    { "source": "/fees", "destination": "/frontend/pages/fees/fees.html" },
    { "source": "/results", "destination": "/frontend/pages/results/results.html" },
    { "source": "/settings", "destination": "/frontend/pages/settings/settings.html" },
    { "source": "/pages/:path*", "destination": "/frontend/pages/:path*" },
    { "source": "/js/:path*", "destination": "/frontend/js/:path*" },
    { "source": "/css/:path*", "destination": "/frontend/css/:path*" },
    { "source": "/public/:path*", "destination": "/frontend/public/:path*" }
  ]
}
