# =========================================================
# College ERP - Backend Environment Configuration Template
# =========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or MongoDB Atlas)
# For local development:
MONGODB_URI=mongodb://127.0.0.1:27017/college_erp
# For MongoDB Atlas in production:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/college_erp?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_strong_random_secret_key_at_least_32_characters
JWT_EXPIRES_IN=24h

# CORS Configuration (Allowed frontend origins in production)
CLIENT_URL=https://your-frontend-deployment.vercel.app

# Tiered Rate Limiting Configuration (Optional overrides)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=200
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000

# Database Seeding Control (Set to true to seed initial users and sample data)
SEED_DATA=false
