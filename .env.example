# =========================================================
# College ERP - Global Environment Configuration Template
# =========================================================

# Backend Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/college_erp
JWT_SECRET=your_super_strong_random_secret_key_at_least_32_characters
JWT_EXPIRES_IN=24h
CLIENT_URL=https://your-frontend-deployment.vercel.app
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=200
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
SEED_DATA=false

# Frontend Configuration (for Static/Vite Deployments)
VITE_API_URL=https://your-backend-deployment.onrender.com/api
